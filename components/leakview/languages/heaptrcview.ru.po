msgid "Paste Clipboard"
msgstr "Вставить из буфера обмена"

#: heaptrcview.sbtnresolve
msgid "Resolve"
msgstr "Уточнить"

#: heaptrcview.sbtnupdate
msgid "Update"
msgstr "Обновить"

#: heaptrcview.schkraw
msgid "Raw leak data"
