<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InIDEConfig"/>
      <Title Value="runtestscodetools"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <i18n>
      <EnableI18N LFM="False"/>
    </i18n>
    <BuildModes>
      <Item Name="Default" Default="True"/>
      <Item Name="Debug">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="runtestscodetools"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <OtherUnitFiles Value="moduletests"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <IncludeAssertionCode Value="True"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
              <StackChecks Value="True"/>
            </Checks>
            <VerifyObjMethodCallValidity Value="True"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
              <UseHeaptrc Value="True"/>
              <TrashVariables Value="True"/>
            </Debugging>
          </Linking>
        </CompilerOptions>
      </Item>
      <Item Name="Release">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="runtestscodetools"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <OtherUnitFiles Value="moduletests"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <CodeGeneration>
            <SmartLinkUnit Value="True"/>
            <Optimizations>
              <OptimizationLevel Value="3"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="False"/>
              <RunWithoutDebug Value="True"/>
              <StripSymbols Value="True"/>
            </Debugging>
            <LinkSmart Value="True"/>
          </Linking>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
      <Modes>
        <Mode Name="default"/>
      </Modes>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="CodeTools"/>
      </Item>
      <Item>
        <PackageName Value="fpcunitconsolerunner"/>
      </Item>
      <Item>
        <PackageName Value="IdeConfig"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="runtestscodetools.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="testfinddeclaration.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestFindDeclaration"/>
      </Unit>
      <Unit>
        <Filename Value="testrefactoring.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestRefactoring"/>
      </Unit>
      <Unit>
        <Filename Value="testglobals.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestGlobals"/>
      </Unit>
      <Unit>
        <Filename Value="testpascalparser.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestPascalParser"/>
      </Unit>
      <Unit>
        <Filename Value="moduletests/fdt_proc_basetypes.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="moduletests/fdt_for_in.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="testmethodjumptool.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestMethodJumpTool"/>
      </Unit>
      <Unit>
        <Filename Value="teststdcodetools.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestStdCodetools"/>
      </Unit>
      <Unit>
        <Filename Value="testcth2pas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestCTH2Pas"/>
      </Unit>
      <Unit>
        <Filename Value="moduletests/fdt_arrays.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="testcodecompletion.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestCodeCompletion"/>
      </Unit>
      <Unit>
        <Filename Value="testcompreaderwriterpas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestCompReaderWriterPas"/>
      </Unit>
      <Unit>
        <Filename Value="testidentcompletion.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestIdentCompletion"/>
      </Unit>
      <Unit>
        <Filename Value="testctpas2js.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestCTPas2js"/>
      </Unit>
      <Unit>
        <Filename Value="testchangedeclaration.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestChangeDeclaration"/>
      </Unit>
      <Unit>
        <Filename Value="testlfmtrees.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestLFMTrees"/>
      </Unit>
      <Unit>
        <Filename Value="testdesignerformtools.pas"/>
