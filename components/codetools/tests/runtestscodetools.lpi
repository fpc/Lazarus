      </Unit>
      <Unit>
        <Filename Value="moduletests/dsgn_bearbuttons.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Dsgn_BearButtons"/>
      </Unit>
      <Unit>
        <Filename Value="moduletests/dsgn_ambigbearbtn.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Dsgn_AmbigBearBtn"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="runtestscodetools"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="moduletests"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
