<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <LRSInOutputDirectory Value="False"/>
      </Flags>
      <SessionStorage Value="InIDEConfig"/>
      <Title Value="Run Lazarus tests"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <local>
        <LaunchingApplication PathPlusParams="\usr\X11R6\bin\xterm -T &apos;Lazarus Run Output&apos; -e $(LazarusDir)\tools\runwait.sh $(TargetCmdLine)"/>
      </local>
      <FormatVersion Value="2"/>
      <Modes>
        <Mode Name="default">
          <local>
            <LaunchingApplication PathPlusParams="\usr\X11R6\bin\xterm -T &apos;Lazarus Run Output&apos; -e $(LazarusDir)\tools\runwait.sh $(TargetCmdLine)"/>
          </local>
        </Mode>
      </Modes>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="LazMouseAndKeyInput"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FPCUnitTestRunner"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
      <Item>
        <PackageName Value="CodeTools"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="runtestsgui.lpr"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="RunTestsGui"/>
      </Unit>
      <Unit>
        <Filename Value="testlpi.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestLpi"/>
      </Unit>
      <Unit>
        <Filename Value="testglobals.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestGlobals"/>
      </Unit>
      <Unit>
        <Filename Value="bugs\bug8432.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="bugs\testfileutil.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="testunits.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestUnits"/>
      </Unit>
      <Unit>
        <Filename Value="bugtestcase.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="BugTestCase"/>
      </Unit>
      <Unit>
        <Filename Value="lcltests\testpen.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="semiauto\semiautotest.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="semiauto\idesemiautotests.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="semiauto\lclsemiautotests.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="lazutils\testlazutils.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestLazUtils"/>
      </Unit>
      <Unit>
        <Filename Value="lcltests\testpagecontrol.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestPageControl"/>
      </Unit>
      <Unit>
        <Filename Value="ideintf\testmenuintf.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="TestMenuIntfDlg"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="TestMenuIntf"/>
      </Unit>
      <Unit>
        <Filename Value="lcltests\testlistview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestListView"/>
      </Unit>
      <Unit>
        <Filename Value="lcltests\testgraphutil.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestGraphUtil"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="runtestsgui"/>
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value="bugs;codetoolstests;lcltests;semiauto;lazutils;ideintf"/>
      <UnitOutputDirectory Value="unitsgui\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <CStyleOperator Value="False"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseHeaptrc Value="True"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAssertionFailedError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
