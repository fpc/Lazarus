#: lazarusidestrconsts.lisinsertheaderofcurrentprocedure
msgid ""
"Insert header of current procedure.\n"
"\n"
"Optional Parameters (comma separated):\n"
"WithStart,          // proc keyword e.g. 'function', 'class procedure'\n"
"WithoutClassKeyword,// without 'class' proc keyword\n"
"AddClassName,       // extract/add ClassName.\n"
"WithoutClassName,   // skip classname\n"
"WithoutName,        // skip function name\n"
"WithoutParamList,   // skip param list\n"
"WithVarModifiers,   // extract 'var', 'out', 'const'\n"
"WithParameterNames, // extract parameter names\n"
"WithoutParamTypes,  // skip colon, param types and default values\n"
"WithDefaultValues,  // extract default values\n"
"WithResultType,     // extract colon + result type\n"
"WithOfObject,       // extract 'of object'\n"
"WithCallingSpecs,   // extract cdecl; inline;\n"
"WithProcModifiers,  // extract forward; alias; external;\n"
"WithComments,       // extract comments and spaces\n"
"InUpperCase,        // turn to uppercase\n"
"CommentsToSpace,    // replace comments with a single space\n"
"                      //  (default is to skip unnecessary space,\n"
"                      //    e.g 'Do   ;' normally becomes 'Do;'\n"
"                      //    with this option you get 'Do ;')\n"
"WithoutBrackets,    // skip start- and end-bracket of parameter list\n"
"WithoutSemicolon,   // skip semicolon at end\n"
msgstr ""
"Εισαγωγή κεφαλίδας της τρέχουσας διαδικασίας.\n"
"\n"
"Προαιρετικές παράμετροι (διαχωρισμένες με κόμμα):\n"
"WithStart,          // λέξη-κλειδί διαδικασίας, π.χ. 'function', 'class procedure'\n"
"WithoutClassKeyword,// χωρίς τη λέξη-κλειδί 'class' της διαδικασίας\n"
"AddClassName,       // εξαγωγή/προσθήκη ClassName.\n"
"WithoutClassName,   // παράλειψη ονόματος κλάσης\n"
"WithoutName,        // παράλειψη ονόματος συνάρτησης\n"
"WithoutParamList,   // παράλειψη λίστας παραμέτρων\n"
"WithVarModifiers,   // εξαγωγή 'var', 'out', 'const'\n"
"WithParameterNames, // εξαγωγή ονομάτων παραμέτρων\n"
"WithoutParamTypes,  // παράλειψη άνω και κάτω τελείας, τύπων παραμέτρων και προεπιλεγμένων τιμών\n"
"WithDefaultValues,  // εξαγωγή προεπιλεγμένων τιμών\n"
"WithResultType,     // εξαγωγή άνω και κάτω τελείας + τύπου αποτελέσματος\n"
"WithOfObject,       // εξαγωγή 'of object'\n"
"WithCallingSpecs,   // εξαγωγή cdecl; inline;\n"
"WithProcModifiers,  // εξαγωγή forward; alias; external;\n"
"WithComments,       // εξαγωγή σχολίων και κενών\n"
"InUpperCase,        // μετατροπή σε κεφαλαία\n"
"CommentsToSpace,    // αντικατάσταση σχολίων με ένα κενό\n"
"                      //  (από προεπιλογή παραλείπονται τα περιττά κενά,\n"
"                      //    π.χ. το 'Do   ;' κανονικά γίνεται 'Do;'\n"
"                      //    με αυτήν την επιλογή προκύπτει 'Do ;')\n"
"WithoutBrackets,    // παράλειψη αρχικής και τελικής παρένθεσης της λίστας παραμέτρων\n"
"WithoutSemicolon,   // παράλειψη semicolon στο τέλος\n"

